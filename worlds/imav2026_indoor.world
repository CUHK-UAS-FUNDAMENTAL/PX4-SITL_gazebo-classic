    <!--
    <include>
      <name>wooden_house_bounds_marker_0</name>
      <uri>model://imav2026_wooden_house_bounds_marker</uri>
      <pose>-2.2501 4.75595 1.2499295 0 0 0</pose>
    </include>
    -->

    <include>
      <name>thermal_sources</name>
      <uri>model://imav2026_thermal_sources</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>
    <!-- 极简封闭空间：4面墙 + 1个天花板 (30x30米，高5米) -->
    <model name='simple_room'>
      <static>1</static>

      <!-- 北墙 -->
      <link name='north_wall'>
        <pose>0 15 2.5 0 0 0</pose>
        <visual name='v'><geometry><box><size>30 0.2 5</size></box></geometry></visual>
        <collision name='c'><geometry><box><size>30 0.2 5</size></box></geometry></collision>
      </link>

      <!-- 南墙 -->
      <link name='south_wall'>
        <pose>0 -15 2.5 0 0 0</pose>
        <visual name='v'><geometry><box><size>30 0.2 5</size></box></geometry></visual>
        <collision name='c'><geometry><box><size>30 0.2 5</size></box></geometry></collision>
      </link>

      <!-- 东墙 -->
      <link name='east_wall'>
        <pose>15 0 2.5 0 0 0</pose>
        <visual name='v'><geometry><box><size>0.2 30 5</size></box></geometry></visual>
        <collision name='c'><geometry><box><size>0.2 30 5</size></box></geometry></collision>
      </link>

      <!-- 西墙 -->
      <link name='west_wall'>
        <pose>-15 0 2.5 0 0 0</pose>
        <visual name='v'><geometry><box><size>0.2 30 5</size></box></geometry></visual>
        <collision name='c'><geometry><box><size>0.2 30 5</size></box></geometry></collision>
      </link>

      <!-- 天花板 -->
      <link name='ceiling'>
        <pose>0 0 5 0 0 0</pose>
        <visual name='v'><geometry><box><size>30 30 0.2</size></box></geometry></visual>
        <collision name='c'><geometry><box><size>30 30 0.2</size></box></geometry></collision>
      </link>
    </model>
  </world>
</sdf>
