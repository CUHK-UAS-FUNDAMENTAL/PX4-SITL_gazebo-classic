      <pose>2.727315 -6.993107 0.03 0 0 0</pose>
    </include>

    <include>
      <uri>model://imav2026_copper_ring</uri>
      <pose>0.190799 4.216640 0.550411 1.570796 0 0</pose>
    </include>

    <include>
