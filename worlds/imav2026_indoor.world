    </include>

    <include>
      <name>copper_disc_3</name>
      <uri>model://imav2026_copper_disc</uri>
      <pose>1.442930 4.539699 0.517247 1.570796 0 0</pose>
    </include>

    <include>
      <name>red_bar_0</name>
      <uri>model://imav2026_red_bar</uri>
      <pose>0 -5.532255 1.0 0 0 0</pose>
    </include>

    <include>
      <name>blue_bar_0</name>
      <uri>model://imav2026_blue_bar</uri>
      <pose>0 -4.527609 1.0 0 0 0</pose>
    </include>

    <include>
      <name>blue_bar_1</name>
      <uri>model://imav2026_blue_bar</uri>
      <pose>0 -3.546240 1.0 0 0 0</pose>
    </include>

    <include>
      <name>baby_0</name>
      <uri>model://imav2026_sleeping_baby</uri>
      <pose>-3.0 4.0 0.2 0 0 0.2</pose>
    </include>

    <include>
      <name>baby_1</name>
      <uri>model://imav2026_sleeping_baby</uri>
