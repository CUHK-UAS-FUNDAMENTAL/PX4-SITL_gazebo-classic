<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.7">
  <model name="landing-sign">
    <static>true</static>
    <pose>0 0 0 0 0 0</pose>
    <link name="link">
      <collision name="collision">
        <geometry>
          <box>
            <size>1 1 0.05</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <box>
            <size>1 1 0.05</size>
          </box>
        </geometry>

        <material>
            <script>
              <uri>model://landing-sign/materials/scripts/landing.material</uri>
              <name>Gazebo/LandingPlatform</name>
            </script>
        </material>


        <!-- <material>
