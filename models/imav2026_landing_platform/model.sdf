<?xml version="1.0"?>
<sdf version="1.6">
  <model name="imav2026_landing_platform">
    <static>true</static>

    <link name="landing_platform_link">
      <pose>0 0 0 0 0 0</pose>

      <visual name="landing_platform_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://imav2026_landing_platform/meshes/landing_platform_v2.dae</uri>
          </mesh>
        </geometry>
      </visual>

      <collision name="landing_platform_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://imav2026_landing_platform/meshes/landing_platform_v2.dae</uri>
          </mesh>
        </geometry>
      </collision>
    </link>

    <plugin name="imav2026_landing_platform_motion" filename="libimav2026_landing_platform_motion_plugin.so">
      <min_x>1.65</min_x>
      <max_x>2.65</max_x>
      <speed_mps>0.1</speed_mps>
    </plugin>
  </model>
</sdf>
