<?xml version='1.0'?>
<sdf version='1.5'>
  <model name='iris_mid360'>

    <include>
      <uri>model://iris</uri>
    </include>

    <!-- imu, /imu, sensor_msgs/Imu in imu_frame -->
    <!-- about 200 Hz -->
    <include>
      <uri>model://imu</uri>
      <pose>0 0 0.06 0 0 0</pose>
    </include>
    <joint name="imu_joint" type="fixed">
      <child>imu::link</child>
      <parent>iris::base_link</parent>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <upper>0</upper>
          <lower>0</lower>
        </limit>
      </axis>
    </joint>

    <!-- livox mid360, /livox/lidar, livox_laser_simulation/CustomMsg in livox_frame -->
    <!-- about 10 Hz -->
    <include>
      <uri>model://mid360</uri>
      <pose>0 0 0.06 0 0 0</pose>
    </include>
    <joint name="mid360_joint" type="fixed">
      <child>mid360::link</child>
      <parent>iris::base_link</parent>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <upper>0</upper>
          <lower>0</lower>
        </limit>
      </axis>
    </joint>

  </model>
</sdf>
